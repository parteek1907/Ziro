# AI & Cloud API Keys (Optional for local simulated fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
FIREBASE_CREDENTIALS_PATH=

# Server Configuration
PROJECT_NAME="ZIRO Backend"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ZIRO Quote Engine (DEMO values, not measured)
SUPPORTED_CURRENCIES='["INR", "USD", "EUR", "GBP", "SGD", "AED", "AUD", "CAD", "JPY"]'
QUOTE_MIN_AMOUNT="0.01"
QUOTE_MAX_AMOUNT="100000000.00"

# FX Provider Configuration
FX_API_BASE_URL="https://api.frankfurter.app"
FX_CACHE_TTL_SECONDS=60
FX_MAX_STALE_SECONDS=900
FX_ALLOW_SIMULATED_FALLBACK=True
FX_MARGIN_BPS=50

# Fees & Settlement Configuration
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FIXED_USD="0.00"
NETWORK_FEE_USD="0.01"
SETTLEMENT_SECONDS_ESTIMATE=5
